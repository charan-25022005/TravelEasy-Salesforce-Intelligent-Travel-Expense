<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Variance_Percentage__c</fullName>
    <description>Budget variance percentage over or under estimated cost.</description>
    <externalId>false</externalId>
    <formula>IF(Estimated_Cost__c &gt; 0, (BLANKVALUE(Actual_Total_Expense__c, 0) - Estimated_Cost__c) / Estimated_Cost__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Variance %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
